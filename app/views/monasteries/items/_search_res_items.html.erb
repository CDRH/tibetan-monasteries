<% if @res.present? && @res.count > 0 %>
  <% @res.items.each do |item| %>
    <div class="search-results buffer-bottom-sm">
      <h3><%= search_item_link(item) %></h3>
      <div class="row">
        <div class="<%= item["highlight"].present? ? "col-md-4" : "col-md-12" %> search-results-info">
          <ul>
            <% if item["date_display"].present? %>
              <li>
                <%= metadata(item, t("search.results.item.date",
                  default: "Date"), "date_display", link: false) %>
              </li>
            <% end %>
            <%# TODO how are we going to structure this metadata? Person within person is weird %>
            <% if item["type"].present? %>
              <li>
                <%= metadata(item, t("search.results.item.type",
                  default: "Religious Tradition"), "type", link: false) %>
              </li>
            <% end %>
            <% if item["rdf"].present? %>
              <li class="associated-figures">
                <span class="array-label"><strong>Associated Religious Figures<% if item["figure_count_k"].present? %> (<%= item["figure_count_k"] %><% end %>):</strong></span>
                <ul>
                <% figures = item["rdf"].select { |i| i["predicate"] != "sameAs" } %>
                <% figures.each do |figure| %>
                  <% id = parse_md_parentheses(figure["subject"]) %>
                  <% name = parse_md_brackets(figure["subject"]) %>
                    <li>
                      <% if name %>
                        <%= link_to name, religious_figures_item_path(id) %>
                      <% else %>
                        <%= name %>
                      <% end%>
                    </li>
                  <% end %>
                </ul>
              </li>
            <% end %>
          </ul>
        </div>
        <% if item["highlight"].present? %>
          <div class="col-md-8 search-results-text">
            <% item["highlight"].each do |key, hls| %>
              <div class="search-results-highlights well">
                <strong><%= key.titleize %>:</strong>
                <% hls.each do |hl| %>
                  <p><%= hl.html_safe %></p>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
