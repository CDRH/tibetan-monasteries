<div class="site-title-container">
  <div class="container">
    <div class="temple-decoration">
      <div class="site-title-block">
        <%= link_to home_path do %>
          <div class="h1">
            <% if I18n.exists?("general.project_shortname", locale) %>
              <span class="site-title">
                <%= t "general.project_shortname", default: "Add project name to locale file" %>
              </span>
            <% end %>
            <% if I18n.exists?("general.project_subtitle", locale) %>
              <small class="site-subtitle">
                <%= t "general.project_subtitle", default: "Add project subtitle to locale file" %>
              </small>
            <% end %>
          </div>
        <% end %>
      </div>
      <%= image_tag ('temple-decoration.svg') %>
    </div>
  </div>
  <div class="temple-base">
    <div class="container">
      <div class="green-block">
      </div>
    </div>
  </div>
</div>
